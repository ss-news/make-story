# Copy to .env and fill in. Real environment variables override this file.

# ---- LLM that rewrites the story into a script ----
# openai  = any OpenAI-compatible API (OpenAI, DeepSeek, Gemini, OpenRouter...)
# codex   = Codex CLI, uses your ChatGPT plan (no key needed, run `codex login` once)
# offline = no LLM, the story is only split into scenes
LLM_PROVIDER=offline

# For LLM_PROVIDER=openai (pick one provider):
#   OpenAI:     LLM_BASE_URL=https://api.openai.com/v1
#   DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1                         LLM_MODEL=deepseek-chat
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# For LLM_PROVIDER=codex (optional)
CODEX_BIN=codex
CODEX_MODEL=

# ---- Background images ----
# pack = scenes from assets/bac-bo-stick (default, free) | procedural = drawn by code
# codex = Codex $imagegen (ChatGPT plan) | fal = FLUX schnell on fal.ai
IMAGE_PROVIDER=pack
FAL_KEY=

# ---- Voice ----
# edge       = Microsoft Edge read-aloud voices (free, unofficial; voices set per language in channel.json)
# elevenlabs = ElevenLabs API. Free plan: ~10k characters/month, no commercial licence (Starter $6+ has one).
#              Each line is cached in cache/tts/, so re-rendering costs no credits.
TTS_PROVIDER=edge
ELEVENLABS_API_KEY=
# Optional. Default eleven_multilingual_v2 (eleven_flash_v2_5 for Vietnamese, which v2 lacks)
ELEVENLABS_MODEL=
# Optional narrator voice id or name; empty = a middle-aged male voice from your account
ELEVENLABS_NARRATOR_VOICE=
